# Dedicated Yawrd Neon project only. Server-side; never prefix with NEXT_PUBLIC_.
# Set through your normal local/server environment; do not commit credentials.
DATABASE_URL=
# Keep owner credentials out of the web process. Operator commands separately
# read the ignored, mode-0600 .env.migrations.local JSON settings file, or an
# explicit YAWRD_MIGRATION_DATABASE_URL in the operator's environment only.
# Legacy YAWRD_DATABASE_URL is also supported; conflicting values fail closed.
# Non-secret endpoint ID, independently confirmed in Neon as development only.
# Required for the explicit migration command; never infer this from the URL.
YAWRD_DEV_DATABASE_ENDPOINT=
YAWRD_APP_ORIGIN=https://your-approved-yawrd-origin.example

# Optional local HTTP testing, ignored in a compiled production build.
# Use http://localhost:3000 with these flags in NODE_ENV=development only.
# Cookies remain Secure and require a browser that trusts localhost.
YAWRD_ALLOW_HTTP_LOCALHOST=0

# Explicit owner authorization required: synthetic writes to the confirmed
# development application database. Also requires YAWRD_DEV_DATABASE_ENDPOINT.
YAWRD_TEST_DATABASE_DEVELOPMENT=0

# Alternative mode: a separate disposable database on the confirmed development
# endpoint. Cannot combine both modes. Records are retained for inspection.
YAWRD_TEST_DATABASE_URL=
YAWRD_TEST_DATABASE_DISPOSABLE=0
